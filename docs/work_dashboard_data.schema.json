{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/work-dashboard/data-standard.schema.json",
  "title": "龙猫工作统计台 · 数据对接标准",
  "description": "外部程序（如计时软件）向工作台推送/导入数据的统一结构。工作台解析时对类型/状态/日期做容错归一化，字段缺失用安全默认值，明确非法值按无效行处理。",
  "type": "object",
  "properties": {
    "app": { "type": "string", "description": "来源标识，建议固定为 WorkDashboard" },
    "version": { "type": "integer", "description": "格式版本，建议 2" },
    "exported_at": { "type": "string", "description": "导出时间 YYYY-MM-DD HH:MM:SS" },
    "count": { "type": "integer", "description": "works 条数（参考，非必填）" },
    "works": {
      "type": "array",
      "description": "日薪工作记录（可含每日收入字段）",
      "items": { "$ref": "#/definitions/work" }
    },
    "presets": {
      "type": "array",
      "description": "日薪预设",
      "items": { "$ref": "#/definitions/preset" }
    },
    "monthly_works": {
      "type": "array",
      "description": "月薪任务（无收入字段）",
      "items": { "$ref": "#/definitions/monthly_work" }
    },
    "monthly_presets": {
      "type": "array",
      "description": "月薪预设（无收入字段）",
      "items": { "$ref": "#/definitions/monthly_preset" }
    },
    "monthly_settings": {
      "type": "array",
      "description": "月薪收入台账（按月一条，可多条；每个 month_key 对应一个月的收入）",
      "items": { "$ref": "#/definitions/monthly_setting" }
    }
  },
  "definitions": {
    "work": {
      "type": "object",
      "description": "日薪工作记录。必填：name、planned_date；其余可省略。",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "description": "工作名称（必填）" },
        "work_type": { "type": "string", "enum": ["regular", "other"], "description": "regular=常规工作 / other=其他工作；也兼容 日常工作/daily/常规 与 临时工作/兼职/extra 等别名" },
        "duration_hours": { "type": "number", "minimum": 0, "description": "花费时长（小时，≥0）" },
        "planned_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}", "description": "计划完成日期 YYYY-MM-DD（必填，可带时间只取前 10 位）" },
        "expected_income": { "type": "number", "minimum": 0, "description": "预期收入（元，≥0）" },
        "notes": { "type": "string", "maxLength": 2000, "description": "备注" },
        "status": { "type": "string", "enum": ["pending", "done"], "description": "pending=待完成 / done=已完成；也兼容 未完成/进行中/in_progress 与 completed/finished/complete 等别名" },
        "actual_duration_hours": { "type": ["number", "null"], "minimum": 0, "description": "实际时长（已完成；缺省回退 duration_hours）" },
        "completed_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}", "description": "完成日期（已完成；缺省回退 planned_date）" },
        "actual_income": { "type": ["number", "null"], "minimum": 0, "description": "实际收入（已完成；缺省回退 expected_income）" }
      },
      "required": ["name", "planned_date"]
    },
    "preset": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "description": "预设名称（必填）" },
        "work_type": { "type": "string", "enum": ["regular", "other"] },
        "duration_hours": { "type": "number", "minimum": 0 },
        "expected_income": { "type": "number", "minimum": 0 },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name"]
    },
    "monthly_work": {
      "type": "object",
      "description": "月薪任务：不含任何收入字段（日薪/月薪数据由顶层键区分，互不干扰）。",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "description": "任务名称（必填）" },
        "work_type": { "type": "string", "enum": ["regular", "other"] },
        "duration_hours": { "type": "number", "minimum": 0 },
        "planned_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}", "description": "计划日期（必填）" },
        "notes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "done"] },
        "actual_duration_hours": { "type": ["number", "null"], "minimum": 0 },
        "completed_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
      },
      "required": ["name", "planned_date"]
    },
    "monthly_preset": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "description": "预设名称（必填）" },
        "work_type": { "type": "string", "enum": ["regular", "other"] },
        "duration_hours": { "type": "number", "minimum": 0 },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name"]
    },
    "monthly_setting": {
      "type": "object",
      "description": "月薪收入配置（单条即可，系统只保留一条）。",
      "properties": {
        "month_key": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "对应月份 YYYY-MM（如 2026-08）" },
        "regular_income": { "type": "number", "minimum": 0, "description": "该月常规工作收入（元）" },
        "other_income": { "type": "number", "minimum": 0, "description": "该月其它工作收入（元）" }
      },
      "required": ["month_key", "regular_income", "other_income"]
    }
  }
}
